# A valid testnet configuration for `akt-reporter check --network testnet`, used by the image smoke test.
# It holds no secrets and no real keys: every value is a placeholder, and `check` makes no RPC request.
# Plain KEY=value lines only, so that `docker run --env-file` reads them as written.
# AKT_REPORTER_SOLANA_MINT is the "mint" program address of AKT_REPORTER_SOLANA_PROGRAM_ID, computed once.
AKT_REPORTER_CHAIN_ID=smoke-1
AKT_REPORTER_REPORTER=akash1zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3vx69t4
AKT_REPORTER_SOLANA_GENESIS_HASH=568M6WvMSthB35xAFHfKSpTghTFrsWSdF91crtRWqwef
AKT_REPORTER_SOLANA_PROGRAM_ID=4btugKM2wJKWdKsTuhxXWPgJfm9BqyZ9urxmiVkqJWwS
AKT_REPORTER_SOLANA_MINT=EkDNuovcgthRi1zhTLQYpvV55eQmZUz51dsrYT2Ee9Qa

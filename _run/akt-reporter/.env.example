# Compose substitutions only; no private keys in this file.
# Use a published version tag or image digest.
OPERATOR_IMAGE=ghcr.io/akash-network/akt-reporter:0.2.0
# The container user. It must own, or be able to read, everything in OPERATOR_HOME.
OPERATOR_UID=10001
OPERATOR_GID=10001
# Existing host directory, mounted read-only at /home/akt-reporter. It holds config/reporter.toml
# and, with the test keyring backend, the keyring.
OPERATOR_HOME=/etc/akt-reporter

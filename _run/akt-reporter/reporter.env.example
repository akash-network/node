# Optional overrides for the reporter. Copy this file to reporter.env, next to docker-compose.yaml.
# Compose passes it to the container as environment variables; it must not hold secrets.
#
# An environment variable overrides <home>/config/reporter.toml, and a flag overrides both.
# A key becomes AKT_REPORTER_<KEY>, with "." and "-" replaced by "_":
# solana.rpc is AKT_REPORTER_SOLANA_RPC, and tx.max-msgs is AKT_REPORTER_TX_MAX_MSGS.
# Unknown AKT_REPORTER_* variables are logged as warnings and ignored.

# Preview never signs. Enable broadcast only after the migration steps in
# contracts/solana/docs/reporter-migration.md, when this reporter is the only process using its key.
# AKT_REPORTER_BROADCAST=true

# mainnet or testnet; each refuses the other's identities.
# AKT_REPORTER_NETWORK=mainnet

# AKT_REPORTER_REPORTER=akash1...
# AKT_REPORTER_CHAIN_ID=akashnet-2

# Inside Docker, localhost is the container, not the host.
# AKT_REPORTER_NODE=tcp://akash-node:26657
# AKT_REPORTER_GRPC_ADDR=akash-node:9090
# AKT_REPORTER_GRPC_INSECURE=true
# AKT_REPORTER_SOLANA_RPC=http://solana-node:8899
# AKT_REPORTER_SOLANA_GENESIS_HASH=
# AKT_REPORTER_SOLANA_PROGRAM_ID=
# AKT_REPORTER_SOLANA_MINT=

# Signing: set one of these when broadcasting, not both.
# AKT_REPORTER_FROM=reporter
# AKT_REPORTER_SIGNER_REMOTE_ADDRESS=kms.internal:9443
# AKT_REPORTER_SIGNER_REMOTE_KEY_ID=reporter
# AKT_REPORTER_SIGNER_REMOTE_CA_FILE=/home/akt-reporter/kms-ca.pem

# Tuning.
# AKT_REPORTER_MAX_AGE=60s
# AKT_REPORTER_SCAN_INTERVAL=15s
# AKT_REPORTER_TX_MAX_MSGS=25
# AKT_REPORTER_TX_MAX_IN_FLIGHT=8

# Prometheus metrics on this address; bind it to a private interface.
# AKT_REPORTER_METRICS_LISTEN=0.0.0.0:2112

# Logging has no environment variables. Use the --log_level and --log_format flags.

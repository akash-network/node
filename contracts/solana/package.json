{
  "name": "akt-solana",
  "version": "0.1.0",
  "private": true,
  "description": "Local development workspace for AKT on Solana",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "bash scripts/setup-local.sh",
    "doctor": "bash scripts/doctor.sh",
    "build": "anchor build",
    "setup:light-client": "bash scripts/setup-light-client.sh",
    "build:verifiable": "bash scripts/verifiable-build.sh",
    "test:unit": "cargo test -p akt-solana --lib",
    "test:sink": "bash scripts/test-sink.sh",
    "test": "bash scripts/test-contract.sh",
    "localnet": "bash scripts/localnet.sh",
    "rehearse:launch": "bash deploy/rehearse-launch.sh",
    "logs": "solana logs --url http://127.0.0.1:${AKT_LOCALNET_RPC_PORT:-17899}",
    "typecheck": "tsc --noEmit",
    "format": "cargo fmt --all && cargo fmt --manifest-path tools/header-encoder/Cargo.toml && prettier --write tests reporter local shared package.json tsconfig.json README.md docs idls/README.md",
    "format:check": "cargo fmt --all --check && cargo fmt --manifest-path tools/header-encoder/Cargo.toml --check && prettier --check tests reporter local shared package.json tsconfig.json README.md docs idls/README.md",
    "reporter": "tsx reporter/run.ts",
    "relayer": "tsx local/relay.ts --watch",
    "test:reporter": "tsx --test reporter/*.test.ts",
    "local:up": "tsx local/stack.ts up",
    "local:down": "tsx local/stack.ts down",
    "local:status": "tsx local/stack.ts status",
    "local:demo": "tsx local/demo.ts",
    "local:check-header": "tsx local/stack.ts check-header",
    "testnet:up": "AKT_LOCAL_PROFILE=testnetify tsx local/stack.ts up",
    "testnet:down": "AKT_LOCAL_PROFILE=testnetify tsx local/stack.ts down",
    "testnet:status": "AKT_LOCAL_PROFILE=testnetify tsx local/stack.ts status",
    "testnet:demo": "AKT_LOCAL_PROFILE=testnetify tsx local/demo.ts",
    "testnet:check-header": "AKT_LOCAL_PROFILE=testnetify tsx local/stack.ts check-header",
    "testnet:scenarios": "AKT_LOCAL_PROFILE=testnetify tsx local/testnet-scenarios.ts",
    "testnet:verify": "AKT_LOCAL_PROFILE=testnetify tsx local/testnet-health.ts",
    "bench:headers": "tsx local/scale.ts",
    "build:header-encoder": "cargo build --locked --manifest-path tools/header-encoder/Cargo.toml",
    "local:reconcile": "tsx local/reconcile.ts",
    "testnet:reconcile": "AKT_LOCAL_PROFILE=testnetify tsx local/reconcile.ts",
    "test:receipts": "tsx local/scale.ts receipts",
    "test:durable": "tsx --test local/durable.test.ts",
    "test:ops": "tsx --test local/relay-policy.test.ts local/reconcile-policy.test.ts local/monitor.test.ts local/relay-config.test.ts local/admin-instructions.test.ts",
    "test:recovery": "tsx local/scale.ts recovery",
    "test:misbehaviour": "tsx local/scale.ts misbehaviour",
    "test:expiry": "tsx local/scale.ts expiry",
    "test:latest-height": "tsx local/scale.ts latest",
    "test:prune": "tsx local/scale.ts prune",
    "test:batch-split": "tsx local/scale.ts split",
    "test:open-relaying": "tsx local/scale.ts open",
    "test:upgrade": "tsx local/upgrade-rehearsal.ts",
    "testnet:settlement": "AKT_LOCAL_PROFILE=testnetify tsx local/settlement-scenarios.ts",
    "setup:metadata": "bash scripts/setup-metadata.sh",
    "local:metadata": "tsx local/token-metadata.ts",
    "local:admin": "tsx local/bridge-admin.ts"
  },
  "dependencies": {
    "@akashnetwork/chain-sdk": "file:.cache/chain-sdk.tgz",
    "@bufbuild/protobuf": "2.11.0",
    "@coral-xyz/anchor": "0.32.1",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@cosmjs/tendermint-rpc": "0.39.0",
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@noble/curves": "1.9.7",
    "@scure/base": "2.4.0",
    "@solana/spl-token": "0.4.15",
    "long": "5.3.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "cosmjs-types": "0.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  }
}
